# Get a free key at https://ipstack.com
IPSTACK_ACCESS_KEY=

# Optional: serve the app under a sub-path. Defaults to /. Rebuild after changing.
# NEXT_PUBLIC_BASE_PATH=/devtools/real-time-tracker

# Optional: serve public/ files (images and map data) from an absolute URL
# (e.g. a CDN, or any host not behind the reverse proxy that fronts this app
# under basePath) instead of a basePath-relative path. A cross-origin host must
# allow CORS for the map data. Leave unset for default behavior.
# NEXT_PUBLIC_ASSET_BASE_URL=
