# Get a free key at https://ipstack.com
IPSTACK_ACCESS_KEY=

# Optional — Turso/libSQL. Unset falls back to a local ./collabfab.db file.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# --- Canonical URL -----------------------------------------------------------
# What crawlers are told about this page: origin and path of its public
# address. Optional; unset falls back to the defaults in lib/site.ts.
# Note: this app is not yet wired for sub-path hosting, so there is no
# NEXT_PUBLIC_BASE_PATH here. These only affect canonical/OG/sitemap URLs.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_PATH=
